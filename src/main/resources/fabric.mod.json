{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_display_name}",
  "description": "${mod_description}",
  "authors": [
    "Cammie",
    "Up"
  ],
  "contributors": [
    "MoriyaShiine"
  ],
  "contact": {
    "homepage": "${homepage_url}",
    "sources": "${sources_url}",
    "issues": "${issues_url}"
  },
  "license": "${license_url}",
  "icon": "icon.png",
  "environment": "*",
  "custom": {
    "mc-publish": {
      "curseforge": "396512",
      "modrinth": "Llu0xJGi",
      "dependencies": [
        "fabric-api(required){curseforge:306612}{modrinth:P7dR8mSH}",
        "resourcefulconfig(required){modrinth:M1953qlQ}{curseforge:714059}",
        "sparkweave(required){modrinth:nf68xfAw}{curseforge:911456}",
        "cardinal-components-base(required){modrinth:K01OU20C}{curseforge:318449}",
        "cardinal-components-entity#(ignore:true)"
      ],
      "loaders": [
        "fabric",
        "quilt"
      ],
      "java": [
        "${java_version}"
      ]
    },
    "modmenu": {
      "links": {
        "modmenu.discord": "${discord_url}"
      }
    },
    "cardinal-components": [
      "${mod_id}:hook_owner"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "=${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": "*",
    "resourcefulconfig": "*",
    "sparkweave": ">=0.8.1 <0.100.0",
    "cardinal-components-base": "*",
    "cardinal-components-entity": "*"
  },
  "entrypoints": {
    "main": [
      "dev.cammiescorner.hookshot.Hookshot"
    ],
    "client": [
      "dev.cammiescorner.hookshot.client.HookshotClient"
    ],
    "fabric-datagen": [
      "dev.cammiescorner.hookshot.datagen.HookshotDatagenerator"
    ],
    "cardinal-components": [
      "dev.cammiescorner.hookshot.registry.HookshotComponents"
    ],
    "emi": [
      "dev.cammiescorner.hookshot.compat.EmiCompat"
    ],
    "jei_mod_plugin": [
      "dev.cammiescorner.hookshot.compat.JeiCompat"
    ],
    "modmenu": [
      "dev.cammiescorner.hookshot.compat.ModmenuCompat"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ]
}
